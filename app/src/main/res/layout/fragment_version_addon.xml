<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/version_addon_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/primary_text"
        style="@style/TextAppearance.AppCompat.Title" />

    <TextView
        android:id="@+id/version_addon_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/secondary_text"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/version_install_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_version_card"
        android:hint="@string/version_install_name_hint"
        android:inputType="text"
        android:padding="12dp"
        android:singleLine="true"
        android:textColor="@color/primary_text"
        android:textColorHint="@color/secondary_text" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/version_addon_select"
        android:textColor="@color/primary_text"
        style="@style/TextAppearance.AppCompat.Subhead" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/version_addon_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <com.kdt.mcgui.MineButton
        android:id="@+id/version_install_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/version_manager_install" />
</LinearLayout>
