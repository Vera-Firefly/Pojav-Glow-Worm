<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/TextAppearance.AppCompat.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/version_manager_select_game"
            android:textColor="@color/primary_text" />

        <ImageButton
            android:id="@+id/version_refresh_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/version_manager_refresh"
            android:src="@android:drawable/ic_popup_sync" />
    </LinearLayout>

    <EditText
        android:id="@+id/version_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_version_card"
        android:hint="@string/version_manager_search"
        android:inputType="text"
        android:padding="12dp"
        android:textColor="@color/primary_text"
        android:textColorHint="@color/secondary_text" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/version_filter_release"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_version_filter"
                android:buttonTint="@color/version_filter_tint"
                android:checked="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:text="@string/version_filter_release"
                android:textColor="@color/primary_text" />

            <CheckBox
                android:id="@+id/version_filter_snapshot"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_version_filter"
                android:buttonTint="@color/version_filter_tint"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:text="@string/version_filter_snapshot"
                android:textColor="@color/primary_text" />

            <CheckBox
                android:id="@+id/version_filter_april_fools"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_version_filter"
                android:buttonTint="@color/version_filter_tint"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:text="@string/version_filter_april_fools"
                android:textColor="@color/primary_text" />

            <CheckBox
                android:id="@+id/version_filter_old"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_version_filter"
                android:buttonTint="@color/version_filter_tint"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:text="@string/version_filter_old"
                android:textColor="@color/primary_text" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/version_online_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <ProgressBar
            android:id="@+id/version_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/version_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/version_manager_no_versions"
            android:textColor="@color/secondary_text"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
