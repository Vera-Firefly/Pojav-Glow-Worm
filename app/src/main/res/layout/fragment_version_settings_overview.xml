<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:fillViewport="true"
    android:scrollbarThumbVertical="@color/minebutton_color">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/fragment_padding_medium"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal">

            <ImageView
                android:id="@+id/version_overview_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:clickable="true"
                android:contentDescription="@string/version_settings_icon"
                android:focusable="true"
                android:padding="2dp"
                android:scaleType="centerInside" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/background_icon_edit"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_edit_profile" />
        </FrameLayout>

        <Button
            android:id="@+id/version_overview_reset_icon"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:minWidth="0dp"
            android:text="@string/version_overview_reset_icon" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/version_overview_name"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/_13ssp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/version_overview_name"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_line"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textColor="@color/primary_text"
                android:textSize="@dimen/_13ssp" />

            <Button
                android:id="@+id/version_overview_edit_name"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:minWidth="88dp"
                android:text="@string/version_overview_edit_name" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/version_overview_summary"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/_13ssp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/version_overview_summary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_line"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textColor="@color/primary_text"
                android:textColorHint="@color/secondary_text"
                android:textSize="@dimen/_13ssp" />

            <Button
                android:id="@+id/version_overview_edit_summary"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:minWidth="88dp"
                android:text="@string/version_overview_edit_summary" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/version_overview_delete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/version_manager_delete_version" />
    </LinearLayout>
</ScrollView>
